# PostgreSQL connection URL (Render / Neon / local Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/one_copy

# Flagsmith server-side environment key (must start with ser. for local evaluation)
FLAGSMITH_ENVIRONMENT_KEY=

# Optional Flagsmith API overrides (leave empty for Flagsmith Cloud defaults)
FLAGSMITH_API_URL=
FLAGSMITH_EVENTS_API_URL=

# Experiment configuration
EXPERIMENT_NAME=submission_recovery
RECOVERY_WINDOW_SECONDS=60
# Enrolled cohort name: qa in Development, live in Production
APP_COHORT=qa

# Security secrets (generate strong random hex strings for production)
COOKIE_SECRET=change-me-dev-cookie-secret-32-bytes-minimum
BALANCE_SECRET=change-me-dev-balance-secret-32-bytes-minimum

# Comma-separated allowed browser origins for Origin validation
APP_ORIGIN=http://localhost:3000

# Environment mode: development | qa | production
ENVIRONMENT=development
